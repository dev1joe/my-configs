(defcfg
    process-unmapped-keys yes
)

(defsrc
    ;; caps mod
    caps esc

    ;; home & end
    u i o p

    ;; home row mods
    a s d f j k l ;

    ;; space bar to nav-layer-toggler
    spc
)

(defvar
    tap-time 200
    hold-time 200
)

(defalias
    ;; home row mode
    a-mod (tap-hold $tap-time $hold-time a lmet)
    s-mod (tap-hold $tap-time $hold-time s lalt)
    d-mod (tap-hold $tap-time $hold-time d lsft)
    f-mod (tap-hold $tap-time $hold-time f lctl)
    g-mod (tap-hold $tap-time $hold-time g (layer-toggle nav))
    j-mod (tap-hold $tap-time $hold-time j rctl)
    k-mod (tap-hold $tap-time $hold-time k rsft)
    l-mod (tap-hold $tap-time $hold-time l ralt)
    ;-mod (tap-hold $tap-time $hold-time ; rmet)


    ;; caps mod
    escctrl (tap-hold 150 200 esc lmet)

    ;; space bar mod
    spc-mod (tap-hold $tap-time $hold-time spc (layer-toggle nav))
)

(deflayer base
    ;; caps mod
    @escctrl caps

    ;; page up & page down
    _ _ _ _

    ;; home row mods, h is transparent
    @a-mod @s-mod @d-mod @f-mod @j-mod @k-mod @l-mod @;-mod

    ;; space bar to nav-layer-toggler 
    @spc-mod
)

;; TODO: cancel all other keys
(deflayer nav
    ;; caps mod
    XX XX

    ;; page up & page down
    home pgdn pgup end

    ;; home row mods
    _ _ _ _ left down up right

    ;; space bar to nav-layer-toggler
    _
)