(defcfg
    process-unmapped-keys yes
    concurrent-tap-hold yes
)

(defsrc
    ;; caps mod
    caps bspc

    ;; remove enter (return)
    ret

    ;; set esc to caps
    esc

    ;; home & end
    u i o p

    ;; home row mods ;; missing g and h
    a s d f j k l ;

    ;; space bar to nav-layer-toggler
    spc
)

(defvar
    tap-time 200
    hold-time 200
)

(defalias
    ;; caps mod
    caps-mod (tap-hold $tap-time $hold-time bspc lmet) ;; lmet == left meta (super) key

    ;; home row mode
    a-mod (tap-hold $tap-time $hold-time a lmet)
    s-mod (tap-hold $tap-time $hold-time s lalt)
    d-mod (tap-hold $tap-time $hold-time d lsft)
    f-mod (tap-hold $tap-time $hold-time f lctl)
    j-mod (tap-hold $tap-time $hold-time j rctl)
    k-mod (tap-hold $tap-time $hold-time k rsft)
    l-mod (tap-hold $tap-time $hold-time l ralt)
    ;-mod (tap-hold $tap-time $hold-time ; rmet)
    
    ;; space bar mod
    spc-mod (tap-hold $tap-time $hold-time spc (layer-toggle nav))
)

(deflayer base
    ;; caps mod
    @caps-mod XX

    ;; remove enter (return)
    XX

    ;; set esc to caps
    caps

    ;; page up & page down
    _ _ _ _

    ;; home row mods, h is transparent
    @a-mod @s-mod @d-mod @f-mod @j-mod @k-mod @l-mod @;-mod

    ;; space bar to nav-layer-toggler 
    @spc-mod
)

(deflayer nav
    ;; caps mod
    XX XX

    ;; remove enter (return)
    XX

    ;; set esc to caps
    esc

    ;; page up & page down
    home pgdn pgup end

    ;; home row mods
    _ _ _ _ left down up right

    ;; space bar to nav-layer-toggler
    _
)

;; TODO: create numbers layer and toggle to it using lalt key (the key position) 

(defchordsv2
    (j k l) ret 200 all-released (nav)
    (s d f) esc 200 all-released (nav)
)